# mellō API — environment variables
# Copy to .env and fill in real values.
#
# ─────────────────────────────────────────────────────────────────────────
#  CREDENTIAL ISOLATION IS A SECURITY BOUNDARY, NOT A CONVENIENCE.
#  The crisis-containment architecture (STEP 4B/4C) depends on FOUR
#  SEPARATE database credentials. Collapsing any of them into one shared
#  URL silently defeats the containment model WITHOUT any code change.
#  Each *_DATABASE_URL below MUST be a distinct least-privilege role.
#  Never point two of these at the same credential. Never reuse the
#  migration/admin connection for runtime.
# ─────────────────────────────────────────────────────────────────────────

# ── Database: migration / admin connection ───────────────────────────────
# Privileged connection used ONLY by backend/migrations/apply.sh to apply
# schema + create the least-privilege roles below. The API runtime does
# NOT read this. Do NOT use it as a runtime credential.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# ── Database: isolated runtime credentials (READ BY THE API) ─────────────
# Each is a separate Postgres role created by backend/migrations
# (0012/0013/0014). They are intentionally non-interchangeable.

# Role: mello_quarantine_rw. May reach ONLY quarantine.crisis_entries.
# Do NOT reuse DATABASE_URL or any other credential here.
QUARANTINE_DATABASE_URL=postgres://mello_quarantine_rw:CHANGE_ME@localhost:5432/postgres

# Role: mello_safety_events_append. INSERT-only on public.safety_events.
# No SELECT/UPDATE/DELETE. Do NOT reuse any other credential here.
SAFETY_EVENTS_DATABASE_URL=postgres://mello_safety_events_append:CHANGE_ME@localhost:5432/postgres

# Role: mello_suppression_rw. Column-scoped to the proactive-pause field.
# Do NOT reuse any other credential here.
SUPPRESSION_DATABASE_URL=postgres://mello_suppression_rw:CHANGE_ME@localhost:5432/postgres

# ── Supabase auth ────────────────────────────────────────────────────────
# The API verifies Authorization: Bearer <jwt> with SUPABASE_JWT_SECRET
# (HS256). SUPABASE_URL / ANON_KEY are client-facing (the API runtime does
# not read them today) — kept for parity with the frontends.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Claude: CLI ONLY — the hosted Anthropic API is forbidden ─────────────
# Project directive: every Claude call routes through the `claude` CLI
# subprocess (`claude -p`), which uses existing Claude Code auth. There is
# DELIBERATELY no ANTHROPIC_API_KEY here. Do not add one; do not wire the
# SDK. Optional: override the CLI binary path.
# CLAUDE_CLI=/full/path/to/claude

# ── Crisis classifier knobs (safe defaults in code; leave unset) ─────────
# Documented so they are not "discovered" and misconfigured. The defaults
# in code are intentional.
# MELLO_CLASSIFIER_MODEL=haiku
# MELLO_CLASSIFIER_TIMEOUT_MS=20000
# MELLO_PROACTIVE_PAUSE_DAYS — the pause-window length is OPEN — 4D
# (clinical/legal). Do NOT set this without a 4D decision; the in-code
# default is a deliberate placeholder, not policy.

# ── Voyage AI (embeddings) — passed through to the retriever subprocess ──
VOYAGE_API_KEY=pa-...

# ── Qdrant — passed through to the retriever subprocess ──────────────────
QDRANT_URL=http://qdrant:6333

# ── Redis — RESERVED, not yet wired (jobs / rate-limit, future) ──────────
# No code reads this today. Present so the substrate choice is explicit.
REDIS_URL=redis://redis:6379

# ── Retriever (Phase 0: API shells out to the Python retriever) ──────────
# RETRIEVER_ENTRYPOINT must point at the REAL script: retriever/retriever.py
# (there is no retrieve.py). NOTE: the relative path resolves from the API
# process cwd — a containerized API must colocate the retriever tree or
# this path will not resolve.
RETRIEVER_PYTHON_BIN=python
RETRIEVER_ENTRYPOINT=../retriever/retriever.py

# ── API ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# CORS_ORIGIN=http://localhost:3000
