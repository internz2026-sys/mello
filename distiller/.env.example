# No ANTHROPIC_API_KEY needed — distiller routes Claude calls through the
# Claude Code CLI (`claude -p`), which uses your existing Claude Code auth.
# Confirm the CLI is installed: `claude --version`.

# Optional model overrides (CLI accepts 'sonnet' / 'opus' aliases or full IDs)
# MELLO_NOTICER_MODEL=sonnet
# MELLO_DISTILLER_MODEL=opus

# Optional: override the path to the claude binary
# CLAUDE_CLI=/full/path/to/claude
