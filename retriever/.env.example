# mellō retriever — environment variables
# Copy to .env and fill in real values.

# ── Claude: CLI ONLY — the hosted Anthropic API is forbidden ─────────────
# The retriever does NOT call Claude. There is deliberately no
# ANTHROPIC_API_KEY here. If reranking/synthesis is added later it MUST
# route through the `claude` CLI subprocess (project directive), never the
# hosted API. Do not add an API key.

# ── Voyage AI — used by seeder.py and retriever.py for embeddings ────────
VOYAGE_API_KEY=pa-your-voyage-key-here
# Optional overrides (defaults are intentional; voyage-3 / 1024-dim):
# VOYAGE_MODEL=voyage-3
# VOYAGE_EMBED_DIM=1024

# ── Embedding provider abstraction ───────────────────────────────────────
# Phase 0–1 default is the Voyage provider. Local (Ollama/nomic) is the
# architected fallback. Switching providers creates a NEW Qdrant
# collection (provider+dim-scoped) — see docs/architecture-debt-review.md
# AD-8 before switching in a populated environment.
# MELLO_EMBEDDING_PROVIDER=voyage
# MELLO_LOCAL_EMBED_MODEL=nomic-embed-text
# OLLAMA_URL=http://localhost:11434

# ── Qdrant ───────────────────────────────────────────────────────────────
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=mello_memories

# ── Retrieval relevance gate ─────────────────────────────────────────────
# Similarity floor (the relevance gate from STEP 3). The default is a
# deliberate philosophy decision — do not lower it casually.
# SIMILARITY_FLOOR=0.30
