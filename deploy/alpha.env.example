# mellō — INTERNAL ALPHA runtime secrets TEMPLATE
#
# Copy to deploy/alpha.env and fill REAL values. deploy/alpha.env is
# git-ignored AND excluded from the Docker build context — it must never
# be committed or baked into an image.
#
# ─────────────────────────────────────────────────────────────────────
#  The database credentials are a SECURITY BOUNDARY. The API refuses to
#  boot (S5-1 guard) unless the three runtime URLs are present, mutually
#  distinct, and distinct from any admin/migration URL. Do NOT collapse.
#
#  IMPORTANT: migrations 0012–0014 create the privilege roles as
#  **NOLOGIN** (mello_quarantine_rw / mello_safety_events_append /
#  mello_suppression_rw). You cannot connect AS those roles. Create
#  three DISTINCT *login users*, GRANT each exactly one privilege role,
#  and connect as the login users (Postgres role inheritance enforces the
#  isolation). The local stack does this automatically via
#  deploy/local/initdb/01-local-logins.sql.
# ─────────────────────────────────────────────────────────────────────

# LOCAL stack (docker-compose.alpha.local.yml): host = the compose
# service name `postgres`; the login users below are created by the
# local init bootstrap. For a VPS/Supabase deployment, point these at
# three distinct managed login roles instead.
POSTGRES_PASSWORD=CHANGE_ME_local_superuser_pw
QUARANTINE_DATABASE_URL=postgres://mello_quarantine_login:CHANGE_ME@postgres:5432/postgres
SAFETY_EVENTS_DATABASE_URL=postgres://mello_events_login:CHANGE_ME@postgres:5432/postgres
SUPPRESSION_DATABASE_URL=postgres://mello_suppression_login:CHANGE_ME@postgres:5432/postgres

# Auth + embeddings. No Supabase in local mode → SUPABASE_JWT_SECRET is a
# real LOCAL dev secret; auth will correctly reject all tokens (safe for
# an invite-only local alpha with no real users). VOYAGE only powers the
# retriever subprocess (not exercised by deploy-smoke).
SUPABASE_JWT_SECRET=CHANGE_ME_local_random
VOYAGE_API_KEY=pa-CHANGE_ME

# Claude CLI auth — TWO supported mechanisms (pick one):
#  (9a, VPS)   CLAUDE_CODE_OAUTH_TOKEN=<token from `claude setup-token`>
#  (9b, LOCAL) leave the token UNSET; docker-compose.alpha.local.yml
#              bind-mounts the host ~/.claude/.credentials.json READ-ONLY,
#              so the in-container CLI uses your existing PC login.
# Never set ANTHROPIC_API_KEY (it overrides both; CLI-only directive /
# AD-2; compose forces it empty). Never put an admin/migration DATABASE_URL
# here — migrations run via the postgres init hook (local) or apply.sh.
