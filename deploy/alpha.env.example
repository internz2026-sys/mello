# mellō — INTERNAL ALPHA runtime secrets TEMPLATE
#
# Copy to deploy/alpha.env and fill REAL values. deploy/alpha.env is
# git-ignored AND excluded from the Docker build context — it must never
# be committed or baked into an image.
#
# ─────────────────────────────────────────────────────────────────────
#  The four database credentials are a SECURITY BOUNDARY. The API
#  refuses to boot (S5-1 guard) unless the three runtime URLs are
#  present, mutually distinct, and distinct from the admin DATABASE_URL.
#  Use four genuinely separate Supabase roles. Do NOT collapse them.
# ─────────────────────────────────────────────────────────────────────

# Three DISTINCT least-privilege Supabase roles (migrations 0012–0014).
QUARANTINE_DATABASE_URL=postgres://mello_quarantine_rw:CHANGE_ME@<supabase-host>:5432/postgres
SAFETY_EVENTS_DATABASE_URL=postgres://mello_safety_events_append:CHANGE_ME@<supabase-host>:5432/postgres
SUPPRESSION_DATABASE_URL=postgres://mello_suppression_rw:CHANGE_ME@<supabase-host>:5432/postgres

# Supabase auth + Voyage embeddings.
SUPABASE_JWT_SECRET=CHANGE_ME
VOYAGE_API_KEY=pa-CHANGE_ME

# Claude CLI auth — long-lived subscription token from `claude setup-token`
# (run once, off-image; see docs/step5-3-operator-runbook.md). Verified
# mechanism for Claude Code v2.1.x. Runtime-only; never bake into image.
CLAUDE_CODE_OAUTH_TOKEN=CHANGE_ME

# Do NOT set ANTHROPIC_API_KEY. It would take precedence over the OAuth
# token and violates the CLI-only directive. Compose forces it empty.
# Do NOT put the admin/migration DATABASE_URL here — it is used only by
# backend/migrations/apply.sh, never in the API runtime.
