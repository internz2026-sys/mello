# Environment
.env
.env.local
.env.*.local

# Operator-managed deploy secrets — NEVER commit (e.g. deploy/alpha.env).
# The matching *.env.example templates ARE committed.
deploy/*.env
!deploy/*.env.example

# Python
__pycache__/
*.py[cod]
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Node
node_modules/
.next/
.expo/
.turbo/
dist/
build/

# Distiller outputs
distiller/output/
retriever/output/

# Hook state markers (transient)
.mello-pending-memory-update
.mello-idle-marker

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Supabase
**/supabase/.temp/
